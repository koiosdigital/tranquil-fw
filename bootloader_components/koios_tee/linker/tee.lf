# TEE Linker Fragment
#
# This fragment controls placement of TEE handler code.
# For bootloader context, we place handlers in a known section
# that gets copied to RTC FAST memory at runtime.
#
# Note: ESP-IDF bootloader linker works differently from app linker.
# Handlers are copied to RTC FAST at init time, so they need to be
# position-independent or compiled for their destination address.

[sections:tee_text]
entries:
    .tee_text+

[scheme:tee_handlers]
entries:
    tee_text -> flash_text

[mapping:tee]
archive: libkoios_tee.a
entries:
    tee_handlers (tee_handlers)
